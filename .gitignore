# Raw Oracle's Elixir CSVs are ~50MB+ and re-downloadable — keep out of git
data/raw/*.csv
data/raw/*.csv.part

# Python
__pycache__/
*.pyc
.venv/
.env

# Scratch formats
*.feather
*.parquet
# ...but the committed weekly archive is the point
!data/processed/major_leagues.parquet

# OS
.DS_Store
data/processed/*.joblib

# Model binaries (torch checkpoints live with joblib outside git)
data/processed/*.pt

# Riot API (personal key + scraped soloq data — never commit)
.riot-api-key
data/raw/soloq/

# Experiment fit caches — regenerable .npy score vectors, ~350MB and growing.
# The rung-2 GBM cache is keyed by a data fingerprint, so a stale entry can
# never be silently reused; there is nothing here worth versioning.
data/processed/expcache_*/
